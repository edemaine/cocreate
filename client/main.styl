:root
  --delete-color: #d32f2f  // trash can of the Delete Pages button
  --palette-size: 32px
  // The following grow to accomodate scrollbars if needed:
  --palette-color: #ccc
  --palette-border: 2px #aaa
  --tooltip-color: hsl(60, 50%, 76%)
  --tooltip-width: 200px
  --tooltip-arrow: 5px
  --dragzone-color: hsla(60, 50%, 76%, 50%)
  --name-width: 8em

.dark
  --delete-color: #ef5350
  --palette-color: #333
  --palette-border: 2px #666
  --tooltip-color: hsl(60, 50%, 25%)

// A few basics from Bootstrap:
*, ::before, ::after
  box-sizing: border-box
svg
  overflow: hidden
input, textarea
  width: 100%
.sr-only
  position: absolute
  width: 1px
  height: 1px
  padding: 0
  margin: -1px
  overflow: hidden
  clip: rect(0, 0, 0, 0)
  white-space: nowrap
  border: 0

kbd
  padding: 2px 4px
  font-family: 'Roboto Mono', monospace
  font-size: 90%
  color: #fff
  background-color: #333
  /.dark &
    color: #333
    background-color: #ddd
  border-radius: 3px
  box-shadow: inset 0 -1px 0 rgba(0,0,0,.25)
  display: inline-block // prevent line breaks in CTRL-something

body
  font-family: 'Roboto Slab', serif
  touch-action: none  // Prevent mobile zooming
  background: #fff
  &.dark
    color: #aaa
    background: #000
input, textarea
  font-family: 'Roboto Slab', serif
  font-size: 16px
  padding-top: 0px
  /.dark &
    color: #aaa
    &::placeholder
      color: #555
    background: #000
  &.pending
    background-color: hsl(0, 0%, 75%)
    /.dark &
      background-color: hsl(0, 0%, 15%)
  &.error
    background-color: hsl(354, 62%, 75%)
    /.dark &
      background-color: hsl(354, 62%, 15%)
  &.success
    background-color: hsl(134, 62%, 75%)
    /.dark &
      background-color: hsl(134, 62%, 15%)

html, body, #root, #container
  width: 100%
  height: 100%
  margin: 0
#container
  display: grid
  grid-template-areas: "left top" \
                       "left center" \
                       "left bottom"
  grid-template-columns: auto 1fr
  grid-template-rows: auto 1fr auto
#tools
  grid-area: left
#pages
  grid-area: top
#bottom
  grid-area: bottom
#center
  grid-area: center
  position: relative

body
  --filter: none
  &.dark
    --filter: invert(1) hue-rotate(180deg)
    @supports (filter: url("#invertFilter"))
      --filter: url(#invertFilter)

.board, .modal, .overlay
  position: absolute
  overflow: hidden
  width: 100%
  height: 100%
  filter: var(--filter)
.board
  cursor: crosshair
  touch-action: none  // PointerEvents only
  user-select: none  // avoid selecting text objects while drawing
.overlay
  pointer-events: none
.nopage
  .board, .overlay
    visibility: hidden !important
    // in particular, disable board's pointer events when no page
#dragzone
  transition: opacity 500ms
  background-color: var(--dragzone-color)
  opacity: 0
  &.drag
    opacity: 1

.palette
  background: var(--palette-color)
  display: flex
  z-index: 1
  user-select: none  // prevent selection e.g. of line thickness numbers
.vertical.palette
  flex-direction: column
  overflow-x: hidden
  overflow-y: auto
  top: 0
  left: 0
  height: 100%
.horizontal.palette
  flex-direction: row
  &.super
    flex-direction: column
  overflow-x: auto
  overflow-y: hidden
  width: 100%
.subpalette
  display: flex

#historyRange
  margin: 0 10px
  height: var(--palette-size)

#urlInput
  height: var(--palette-size)
#textInput
  height: 48px
  min-height: 48px
  resize: vertical
#name
  width: var(--name-width)

button(activeBorder)
  border: var(--palette-border) outset
  cursor: pointer
  &.selected, &.active
    --palette-border: activeBorder
    background: rgba(0,0,0,0.2)
    border: var(--palette-border) inset rgba(0,0,0,0.2)
    /.dark &
      border: var(--palette-border) inset rgba(0,0,0,0.75)
    &[data-color="black"]
      border: var(--palette-border) inset rgba(255,255,255,0.2)
      /.dark &
        border: var(--palette-border) inset rgba(255,255,255,0.3)
  &:active
    --palette-border: activeBorder
    background: rgba(0,0,0,0.4)
    border: var(--palette-border) inset rgba(0,0,0,0.4)
    /.dark &
      border: var(--palette-border) inset rgba(0,0,0,1)

.pageList
  display: flex
.page
  display: flex
  height: var(--palette-size)
  padding: 2px 0.3em
  border-radius: 25% 25% 0 0
  border-bottom: none !important
  button(2px)
  // Avoid link styling
  color: inherit
  text-decoration: inherit
.icon
  display: inline-block
  svg
    height: 0.75em
.pageHeader
  text-align: center
  font-weight: bold
.user
  margin-right: 0.5em
  // Comingle styling of .presence:
  white-space: nowrap  // prevent line break between icon and name
  > span
    white-space: normal  // allow line break within name

.tool, .attrib
  flex: none
  width: var(--palette-size)
  height: var(--palette-size)
  flex-basis: var(--palette-size)
  overflow: hidden
  position: relative
  button(3px)
  > span
    vertical-align: middle  // center wide icons like users

.tool
  padding: 2px

.width, .arrow, .dash, .fontSize
  display: flex
  justify-content: center
  align-items: center
  text
    fill: var(--currentColor)
    &.label
      fill: black
    text-anchor: middle
    font-size: 10px
  svg
    filter: var(--filter)
.width, .dash
  line
    stroke: var(--currentColor)

.color, .opacity, [data-tool="fill"] svg
  width: 100%
  height: 100%
  filter: var(--filter)

#opacities > .tool:not(:first-child)
  padding: 0
.opacity
  background: linear-gradient(to bottom right, #999, #fff);

.custom.color
  input[type="color"], .set
    position: absolute
    width: calc(100% - 2 * 5px)
    height: calc(100% - 2 * 5px)
    margin: 5px
  input[type="color"]
    opacity: 0
    pointer-events: none
  .set
    background: linear-gradient(to bottom right, red,orange,yellow,green,blue,indigo,violet)

.tooltip
  cursor: help
  position: absolute
  display: block
  z-index: 99
  width: var(--tooltip-width)
  font-size: 16px
  /.dark &
    color: #ddd
    path
      fill: #ddd
  svg
    height: 1em
    vertical-align: baseline

  opacity: 0
  &.show
    opacity: 1
  &.fade
    transition: opacity .15s linear

  .tooltip-inner
    background: padding-box var(--tooltip-color)
    padding: 5px 8px

  // Arrow
  .tooltip-arrow
    position: absolute
    width: var(--tooltip-arrow)
    height: var(--tooltip-arrow)
    border: var(--tooltip-arrow) solid transparent
    pointer-events: none
    &::before
      content: ''
  &[x-placement^="right"]
    padding-left: var(--tooltip-arrow)
    .tooltip-arrow  // Left arrow
      left: calc(-1 * var(--tooltip-arrow))
      border-right-color: var(--tooltip-color)
  &[x-placement^="bottom"]
    padding-top: var(--tooltip-arrow)
    .tooltip-arrow  // Left arrow
      top: calc(-1 * var(--tooltip-arrow))
      border-bottom-color: var(--tooltip-color)
  &[x-placement^="top"]
    padding-bottom: var(--tooltip-arrow)
    .tooltip-arrow  // Left arrow
      bottom: calc(-1 * var(--tooltip-arrow))
      border-top-color: var(--tooltip-color)

  .hotkeys
    float: right
    .hotkey
      margin-top: 1px
      margin-left: 3px

  &.menu
    cursor: pointer
    --tooltip-color: var(--palette-color)
    --tooltip-width: calc(var(--palette-size) + var(--name-width))

    .tooltip-inner
      padding: 0

    .item, .none
      padding: 4px 8px
    .item
      &:not(:last-child)
        border-bottom: solid var(--palette-border)
      &:hover
        background: rgba(0,0,0,0.2)
        /.dark &
          background: rgba(255,255,255,0.2)
    .none
      font-style: italic

.clear
  clear: both

.spacer
  flex-basis: 100%
  min-height: calc(var(--palette-size)/2)
  min-width: calc(var(--palette-size)/2)

svg
  .highlight
    opacity: 0.333
    pointer-events: none
  .selected
    opacity: 0.666
    pointer-events: none
  .anchor
    stroke: rgba(0,0,0,0.666)
    fill: rgba(0,0,0,0.25)
    &:hover
      stroke: rgba(0,0,0,0.888)
      fill: rgba(0,0,0,0.5)
    &.select
      stroke: rgba(0,0,0,0.888)
      fill: rgba(0,0,0,0.75)
      &:hover
        stroke: rgba(0,0,0,0.999)
        fill: rgba(0,0,0,0.888)
  line.cursor
    opacity: 0.5
    stroke: black
    stroke-linecap: round
  .selected line.cursor
    visibility: hidden // don't highlight cursor in selection
  .selector
    fill: rgba(255,255,255,0.25)
    stroke: rgba(0,0,0,0.5)
    pointer-events: none  // avoid .outline flickering as we drag over it
  .outline
    fill: rgba(0,0,0,0.05)
    stroke: rgba(0,0,0,0.5)
    &:hover
      fill: rgba(0,0,0,0.15)
  tspan.code
    font-family: 'Roboto Mono', monospace
  tspan.emph
    font-style: oblique
  tspan.strong
    font-weight: bold
  tspan.strike
    text-decoration: line-through
  .bbox
    fill: rgba(0,0,0,0)

body.history
  --palette-color: hsl(32,40%,73%)  // sepia-like
  &.dark
    --palette-color: hsl(32,40%,20%)
  #mainBoard, #remotes
    display: none
body:not(.history)
  #historyBoard
    display: none

// Add drop shadow to remote cursors, to avoid e.g. text blending into drawing
#remotes
  > g  // root
    > g  // cursor
      filter: drop-shadow(1px 1px 1px white)

.loading
  position: fixed
  display: flex
  justify-content: center
  align-items: center
  top: 0
  left: 0
  width: 100%
  height: 100%
  > svg
    width: 10%
    height: 10%
    animation: fa-spin 2s ease infinite

.offline
  position: absolute
  bottom: 0
  right: 0
  text-align: right
  padding: 0.25em
  &.show
    padding: 1em
  z-index: 2
  background: #dd8080bb
  /.dark &
    background: #290000bb
    a
      color: #88f
  .status
    font-style: italic
  > h1
    margin-top: 0

  // allow click-through to buttons behind
  pointer-events: none
  a
    pointer-events: auto

// Modal dialogs
.modal
  padding: 20px 40px
  cursor: help
  color: black
  overflow: auto
.modal.error
  background: pink
.modal.info
  background: #ddd
.modal-title
  font-weight: bold
  font-size: larger

// Delete Pages dropdown (below its button) and confirmation (centered)
.pageDelMenu, .pageDelDialog, .pageDelNotice, .pageLockNotice
  background: var(--palette-color)
  border: var(--palette-border) outset
  box-shadow: 0 3px 14px rgba(0, 0, 0, 0.35)
  line-height: 1.3
.pageDelMenu
  position: fixed
  z-index: 100
  width: 16em
  padding: 4px
  display: flex
  flex-direction: column
  gap: 4px
.pageDelOption, .pageDelHist, .pageDelDialog button, .pageDelNotice .pageDelButtons button
  font: inherit
  color: inherit
  background: transparent
  text-align: left
  button(2px)
.pageDelOption
  display: flex
  align-items: center
  gap: 8px
  padding: 2px 8px 2px 2px
  white-space: nowrap
  svg
    flex: none
    width: 28px
    height: 28px
  small
    display: block
    font-size: 75%
    opacity: 0.8
    white-space: normal
    text-wrap: balance
  &:hover:not(:disabled), &:focus-visible
    background: rgba(0, 0, 0, 0.12)
  &:disabled
    cursor: not-allowed
    opacity: 0.5
.pageDelHistory  // Undo Delete / Redo Delete, centered below the four choices
  display: flex
  justify-content: center
  gap: 8px
  margin-top: 4px
  padding-top: 8px
  border-top: 1px solid rgba(128, 128, 128, 0.55)
.pageDelHist
  flex: 1 1 0
  min-width: 0  // two equal buttons that always fit the menu's width
  display: flex
  align-items: center
  justify-content: center
  gap: 5px
  padding: 4px
  font-size: 14px
  white-space: nowrap
  .histIcon
    flex: none
    display: flex
    svg
      width: 13px
      height: 13px
  span
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
  &:hover:not(:disabled), &:focus-visible
    background: rgba(0, 0, 0, 0.12)
  &:disabled
    cursor: not-allowed
    opacity: 0.5
[data-tool="pageDel"] svg .delCan  // toolbar button: red trash can
  fill: var(--delete-color)
.delIcon
  .base
    fill: currentColor
  .halo  // outline in background color, to separate overlays from trash can
    fill: none
    stroke: var(--palette-color)
    stroke-width: 4
    stroke-linejoin: round
    stroke-linecap: round
    &.fill
      fill: var(--palette-color)
  .sheet
    fill: var(--palette-color)
    stroke: currentColor
    stroke-width: 1.5
    stroke-linejoin: round
  .line, .arc
    fill: none
    stroke: currentColor
    stroke-width: 1.8
    stroke-linecap: round
    stroke-linejoin: round
  .head
    fill: currentColor
  text
    font-family: inherit
    font-weight: 900
    font-size: 13px
    &.halo
      fill: var(--palette-color)
    &.txt
      fill: currentColor
.pageDelVeil
  position: fixed
  top: 0
  left: 0
  right: 0
  bottom: 0
  z-index: 200
  display: flex
  align-items: center
  justify-content: center
  background: rgba(0, 0, 0, 0.15)
.pageDelDialog
  width: 22em
  max-width: calc(100% - 32px)
  padding: 16px 20px
  p
    margin: 0 0 16px
  .pageDelButtons
    display: flex
    gap: 10px
  button
    flex: 1
    padding: 6px 10px
    text-align: center
  .danger
    color: #fff
    background: #c33
    &:hover
      background: #d44

// Messages about pages at the top of the screen, one below the other.  They do
// not block drawing: only the messages themselves take clicks.  Each message
// slides down from the top when it comes and back up when it goes, and the one
// below it moves along (see `Notice` in PageTrash.coffee, which keeps a message
// until its leaving animation is over, as long as `animation-duration` of
// `.pageNotice.leaving` here).
.pageNotices
  position: fixed
  z-index: 90
  top: calc(var(--palette-size) + 12px)
  left: 50%
  transform: translateX(-50%)
  width: 22em
  max-width: calc(100% - 32px)
  display: flex
  flex-direction: column
  pointer-events: none
.pageNotice
  display: grid
  grid-template-rows: 1fr
  filter: drop-shadow(0 3px 7px rgba(0, 0, 0, 0.35))  // (a box-shadow would be cut off by .pageNoticeClip)
  animation: pageNoticeIn 0.35s cubic-bezier(0.22, 1, 0.36, 1)
  &.leaving
    animation: pageNoticeOut 0.3s cubic-bezier(0.4, 0, 1, 1) forwards
    .pageDelNotice, .pageLockNotice
      pointer-events: none
.pageNoticeClip  // the message grows out of, and shrinks into, the top of its place
  min-height: 0
  overflow: hidden
.pageDelNotice, .pageLockNotice
  position: relative
  box-sizing: border-box
  margin-bottom: 8px  // the space to the next message goes along with this one
  padding: 12px 16px
  box-shadow: none  // (see .pageNotice)
  pointer-events: auto
  animation: pageNoticeSlideIn 0.35s cubic-bezier(0.22, 1, 0.36, 1)
  .pageNotice.leaving &
    animation: pageNoticeSlideOut 0.3s cubic-bezier(0.4, 0, 1, 1) forwards
  p
    margin: 0
    padding-right: 16px  // (not under the cross)
    text-wrap: balance
@keyframes pageNoticeIn
  from
    grid-template-rows: 0fr
    opacity: 0
  to
    grid-template-rows: 1fr
    opacity: 1
@keyframes pageNoticeOut
  from
    grid-template-rows: 1fr
    opacity: 1
  to
    grid-template-rows: 0fr
    opacity: 0
@keyframes pageNoticeSlideIn
  from
    transform: translateY(-100%)
  to
    transform: none
@keyframes pageNoticeSlideOut
  from
    transform: none
  to
    transform: translateY(-100%)
@media (prefers-reduced-motion: reduce)
  .pageNotice, .pageNotice.leaving, .pageNotice .pageDelNotice, .pageNotice .pageLockNotice
    animation: none !important

// The cross in the top right corner of a message
.pageNoticeClose
  position: absolute
  top: 4px
  right: 4px
  width: 24px
  height: 24px
  padding: 0
  display: flex
  align-items: center
  justify-content: center
  font: inherit
  color: inherit
  background: transparent
  border: none
  border-radius: 3px
  cursor: pointer
  svg
    width: 12px
    height: 12px
    fill: none
    stroke: currentColor
    stroke-width: 1.6
    stroke-linecap: round
  &:hover, &:focus-visible
    background: rgba(0, 0, 0, 0.12)
  &:active
    background: rgba(0, 0, 0, 0.25)

// "Pages ... were deleted. Bring them back?"
.pageDelNotice
  p
    margin: 0 0 12px
  .pageDelButtons
    display: flex
    gap: 10px
  .pageDelButtons button
    flex: 1
    padding: 4px 10px
    text-align: center

// Page list: the mark of a locked page, and who locked it in its tooltip
.page .icon.lock svg
  height: 0.7em
.pageLockInfo
  text-align: center

.close
  float: right
  width: 24px
  cursor: pointer
  &:hover
    color: #555
  &:active
    color: #888

.linkToRoom
  font-size: larger
.qrCode
  svg
    width: 100%
    max-height: 50vh
  filter: var(--filter)

// Based on keyframes from Font Awesome Free (see `lib/icons.coffee`).
@keyframes fa-spin
  0%
    transform: rotate(0deg)
  100%
    transform: rotate(360deg)

#download
  display: none

.center
  text-align: center
.small
  font-size: 80%

// Drawing

.pen
  line
    stroke-linecap: round
  polyline
    stroke-linecap: round
    stroke-linejoin: round
    fill: none

.grid
  pointer-events: none
  stroke-width: 0.96
  stroke: #c4e3f4
